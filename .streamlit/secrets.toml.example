# Copy this file to .streamlit/secrets.toml for local development.
# NEVER commit the real secrets.toml file.

GEMINI_API_KEY = "replace-with-your-server-side-key"
GEMINI_MODEL = "gemini-3.8-flash"

# Optional: set this only for a hosted reviewer demo. Leave blank locally.
# The code is checked server-side and is not exposed in the repository.
REVIEWER_ACCESS_CODE = ""

# Deployment-level cost controls for an MVP/testing environment.
MAX_BATCH_ROWS = 1000
MAX_CALIBRATION_ROWS = 100
